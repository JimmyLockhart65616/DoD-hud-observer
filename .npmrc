# npm 7+ auto-installs peer dependencies. This tree predates that and cannot
# satisfy them at the root: react-bootstrap@1.5.2 declares `peer react-dom
# >=16.8.0`, the root package.json pins neither react nor react-dom, and the
# lockfile carries no entry for either -- so npm resolves the peer to the
# current react-dom (19.x), which in turn peer-requires react ^19, and that
# contradicts the react@16.14.0 chosen for react-bootstrap's other peers.
#
# The result is that BOTH `npm install` and `npm ci` fail outright on a clean
# clone with ERESOLVE. Anyone already set up keeps working, because their
# existing node_modules hides it -- so it only ever bites new contributors and
# fresh CI runners, which is the worst possible audience for it.
#
# The frontend deps here are NOT dead weight to be deleted: web/package.json
# does not declare react-bootstrap, bootstrap, react-icons, react-router-dom or
# zustand, and resolves them from the root tree by hoisting (see CLAUDE.md on
# zustand living at the root while react lives in web/node_modules). Removing
# them breaks the web build.
#
# legacy-peer-deps restores the npm 6 behaviour this lockfile was authored
# under: install what the lockfile says and do not try to reconcile peers. It
# changes NO resolved version -- `npm ci` installs exactly the locked tree
# either way -- it only stops npm from inventing a react-dom nobody asked for.
#
# web/ installs cleanly without this and deliberately has no .npmrc of its own
# (npm does not walk parent directories for one, so this file applies to root
# installs only).
#
# The real fix is to pin react/react-dom at the root, or to move the frontend
# deps into web/package.json where they are actually used. Both change how the
# app resolves React at build time, so neither belongs in a drive-by commit.
legacy-peer-deps=true
